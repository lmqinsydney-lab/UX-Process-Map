      "states": [
        {
          "id": "default",
          "name": "默认"
        }
      ]
    },
    {
      "id": "coupon-bubble",
      "name": "分期优惠气泡",
      "desc": "分期还款按钮上的「首期0息」优惠引导气泡，仅作展示引导、不可单独点击；优惠置灰时隐藏。",
      "states": [
        {
          "id": "show",
          "name": "展示"
        },
        {
          "id": "hidden",
          "name": "隐藏（优惠置灰）",
          "note": "优惠置灰时不展示气泡"
        }
      ]
    },
    {
      "id": "quick-grid",
      "name": "功能宫格",
      "desc": "频道页功能入口宫格：可取现金、优惠券、还款助手、成长中心、周账单。",
      "states": [
        {
          "id": "default",
          "name": "默认"
        }
      ]
    },
    {
      "id": "bill-list",
      "name": "账单列表",
      "desc": "账单条目列表（全部/分期/退款 tab），展示各笔账单金额、优惠与状态。",
      "states": [
        {
          "id": "default",
          "name": "默认"
        }
      ]
    },
    {
      "id": "installment-coupon",
      "name": "分期优惠",
