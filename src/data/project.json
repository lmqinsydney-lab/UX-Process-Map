        {
          "id": "default",
          "name": "默认"
        }
      ]
    },
    {
      "id": "amount-display",
      "name": "金额展示",
      "desc": "金额展示区：应还/可分期/剩余待还金额与说明文案。",
      "states": [
        {
          "id": "default",
          "name": "默认"
        }
      ]
    },
    {
      "id": "action-buttons",
      "name": "主操作按钮",
